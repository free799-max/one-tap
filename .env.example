# ============================================================
# OneTap Docker Compose 环境变量
#
# 首次部署：
#   cp .env.example .env
#   填写 POSTGRES_PASSWORD，其余保持默认即可
#   docker compose up -d --build
#
# 本文件用于按需覆盖程序内置配置，各项说明见下方注释。
# ============================================================

# ---------- 访问 ----------
# 宿主机访问端口；容器内部固定监听 80
APP_PORT=5000

# ---------- 数据库 ----------
# 仅在 PostgreSQL 数据卷首次创建时生效；已有数据卷时修改不会改变数据库账号
POSTGRES_DB=onetap
POSTGRES_USER=onetap

# 必填。建议用 openssl rand -hex 24 生成十六进制密码，
# 避免 @ : / 等字符破坏 DATABASE_URL
POSTGRES_PASSWORD=

# ---------- 应用 ----------
APP_NAME=OneTap
TZ=Asia/Shanghai

# 可选。留空时首次启动自动生成并持久化到 DATA_ROOT/.secret_key，重启后保持不变。
# 只有需要自行指定 JWT 签名密钥时才填写。
SECRET_KEY=

# 登录令牌有效期（分钟）
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# false：仅首个用户可注册并自动成为管理员；true：开放后续注册
REGISTRATION_OPEN=false

# 允许跨域的来源，逗号分隔；前后端同源部署通常留空
CORS_ORIGINS=

# ---------- 数据目录 ----------
# 宿主机数据目录，相对路径以本文件所在目录为准
DATA_DIR=./data

# 宿主机路径别名：自动为「宿主机路径 ↔ 容器内路径」建立软链，
# 让 Compose 标签、相对挂载和 Stack 详情使用宿主机真实路径。
# 旧版本创建的项目无需迁移数据库；设为 false 可回到旧行为。
# HOST_PATH_ALIAS_ENABLED=true
# DATA_ROOT 对应的宿主机路径默认通过 Docker 自动探测；自定义容器 hostname
# 导致探测失败时，可显式填写 DATA_DIR 对应的宿主机绝对路径。
# HOST_DATA_ROOT=

# ---------- 应用市场与自动化方案 ----------
# MANAGE_BASE_URL 是应用市场同步、授权与专属加速的管理端地址。
# 留空会关闭同步，设置页会提示「未配置授权管理端地址」。
# 官方镜像构建时已写入默认值 https://m.one-tap.vip,https://m.one-tab.vip；
# 本文件的同名变量优先于镜像默认值，需要指向自建管理端时才取消注释。
# 支持逗号分隔多个地址，前一个不可用时自动重试下一个。
# 其余两项已写入后端默认值，仅在需要覆盖时才取消注释。
# MANAGE_BASE_URL=https://m.one-tap.vip,https://m.one-tab.vip
# MANAGE_SYNC_INTERVAL_MINUTES=30
# MANAGE_SYNC_ON_STARTUP=true
